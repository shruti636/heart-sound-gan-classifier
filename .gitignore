# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Project-specific data exclusions
# Exclude raw audio recordings (large wav binaries)
data/raw/*.wav

# Exclude preprocessed numpy features (large files)
data/processed/*.npy

# Exclude trained Keras models (large binaries)
models/
*.keras

# Exclude generated synthetic feature arrays
outputs/synthetic_features/
outputs/**/*.npy

# IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
